# Painel/API: em produção, configure no hPanel e use MongoDB com transações/TLS.
MONGODB_URI=mongodb://127.0.0.1:27017/?replicaSet=rs0
MONGODB_DB=tributo
XML_ENCRYPTION_KEY=BASE64_DE_32_BYTES_ALEATORIOS
HOST=127.0.0.1
PORT=3000
COOKIE_SECURE=false
# Hash SHA-256 do código inicial criado localmente. Após criar admin, remova no hPanel.
BOOTSTRAP_ADMIN_TOKEN_SHA256=COLOQUE_64_CARACTERES_HEX

# Agente Windows (somente no servidor da Maximum; nunca no painel)
API_BASE_URL=http://127.0.0.1:3000
AGENT_TOKEN=TOKEN_EXIBIDO_UMA_VEZ_NO_PAINEL
AGENT_STATE_DIR=.agent-data
