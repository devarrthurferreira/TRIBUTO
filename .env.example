# Painel/API Node.js. Em produção, configure as variáveis no hPanel da Hostinger;
# não envie credenciais do banco ou tokens ao repositório. O Node não lê .env automaticamente.
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=USUARIO_DO_BANCO
MYSQL_PASSWORD=SENHA_DO_BANCO
MYSQL_DATABASE=NOME_DO_BANCO
HOST=127.0.0.1
PORT=3000
COOKIE_SECURE=false
# Hash SHA-256 do código inicial gerado localmente. Remova após criar o primeiro admin.
BOOTSTRAP_ADMIN_TOKEN_SHA256=COLOQUE_64_CARACTERES_HEX

# Agente Windows: configure apenas no servidor da Maximum, nunca no painel.
API_BASE_URL=http://127.0.0.1:3000
AGENT_TOKEN=TOKEN_EXIBIDO_UMA_VEZ_NO_PAINEL
AGENT_STATE_DIR=.agent-data
AGENT_POLL_MS=60000

# Caixa de entrada oficial da Meta. Defina todas as seis variáveis para habilitar.
# Callback HTTPS: /v1/whatsapp/webhook (assine o campo "messages")
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_SECTOR=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_GRAPH_VERSION=

# Para parear um número no Baileys, use WHATSAPP_MODE=baileys e defina WHATSAPP_SECTOR.
# Chave de criptografia da sessão, gerada uma vez com `openssl rand -hex 32`.
# Mantenha esta chave privada e estável entre implantações.
WHATSAPP_MODE=
WHATSAPP_BAILEYS_AUTH_KEY=
